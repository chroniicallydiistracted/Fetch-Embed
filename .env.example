# Environment Variables for Fetch-Embed
# Copy this to .env and fill in your API keys

# Google Books API Key (optional but recommended)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Audible API Key (optional, for Amazon Product Advertising API)
# Get your key at: https://affiliate-program.amazon.com/gp/advertising/api/detail/main.html
AUDIBLE_API_KEY=

# ISBNdb API Key (optional, paid service)
# Get your key at: https://isbndb.com/
ISBNDB_API_KEY=

# Logging level
LOG_LEVEL=INFO
